VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_v3_site_key_here
VITE_ENABLE_GOOGLE_SIGN_IN=false
VITE_ENABLE_INTERNAL_QA_ROUTES=false

# AI master switch. Default is OFF: anything other than exactly "true"
# leaves every AI feature paused and the AI buttons disabled.
# Must match AI_ENABLED on the Cloud Functions side -- that one is what
# actually stops the spending; this one only hides the buttons.
VITE_AI_ENABLED=false
